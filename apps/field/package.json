{
  "name": "@pinpoint/field",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Field app: React/TS inside a Capacitor native wrapper (needed for each phone's offline speech engine).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
