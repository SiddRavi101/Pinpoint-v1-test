    "cap:android": "cap open android"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/privacy-screen": "8.0.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor-community/text-to-speech": "8.0.2",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capgo/capacitor-native-biometric": "8.9.1",
    "@capgo/capacitor-speech-recognition": "8.4.4",
    "@huggingface/transformers": "4.3.2",
    "@pinpoint/core": "0.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "jsqr": "1.4.0",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "6.1.2"
  },
  "devDependencies": {
